                //     from_y: edge[1];
                //     to_x: edge[2];
                //     to_y: edge[3];
                // }

                // place every edges
                for edge in edges: Edge {
                    stroke: #8c8cee7a;
                    stroke_width: 4px;
                    from_x: edge.from_x;
                    from_y: edge.from_y;
                    to_x: edge.to_x;
                    to_y: edge.to_y;
                }

                // temp bubble
                // bubble_b := TaskBubble {
                //     x: workbench.center_x + self.task.x - self.width / 2;
                //     y: workbench.center_y + self.task.y - self.height / 2;
