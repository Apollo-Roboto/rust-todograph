                // place every tasks
                for task in tasks: TaskBubble {
                    x: workbench.center_x + task.x - self.width / 2;
                    y: workbench.center_y + task.y - self.height / 2;
                    task: task;
                    moved_by(x, y) => {
                        task.x = x + task.x;
                        task.y = y + task.y;
