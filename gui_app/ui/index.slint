import { Button, VerticalBox, HorizontalBox, LineEdit, Palette, TextEdit, CheckBox, Switch } from "std-widgets.slint";
import { WorkBench, DragableRectangle } from "widgets/workbench.slint";
import { Styles } from "styles.slint";
import { MindTask, MindTaskState } from "models.slint";
import { Bubble } from "widgets/bubble.slint";
import { Edge } from "widgets/workbench_edge.slint";
import { TaskDetailPanel } from "widgets/task_detail_panel.slint";
import { MiddleProgressBar } from "widgets/middle_progress_bar.slint";
import { ThemeSwitch } from "widgets/theme_switch.slint";
import { FileDialogButton, FileDialogType } from "widgets/file_dialog_button.slint";

export { FileDialogButtonGlobal } from "widgets/file_dialog_button.slint";

enum TaskLoadingState {
    None, Loading, Error,
}
enum TaskSavingState {
    None, Saving, Error,
}
enum AppMode {
    None, SetParent, AddChildren,
}

component TaskBubble {
    in property <MindTask> task;
    in property <bool> extra_info: false;
    in property <brush> default_color: Styles.todo_color;
    in property <brush> todo_color: Styles.todo_color;
    in property <brush> doing_color: Styles.doing_color;
    in property <brush> done_color: Styles.done_color;
    in property <bool> active: false;
    out property <bool> dragged <=> dr.dragged;
    out property <bool> has-hover <=> dr.has-hover;
    callback clicked();
    callback released();
    callback add_children_clicked();
    callback delete_clicked();
    callback duplicate_clicked();
    callback moved_by(x: length, y: length);
    callback new_children_clicked();
    callback remove_parent_clicked();
    callback set_parent_clicked();
    callback state_change_clicked(state: MindTaskState);
    dr := DragableRectangle {
        moved_by(x, y) => {
            root.moved_by(x, y);
        }
        clicked => {
            root.clicked();
        }
        released => {
            root.released();
        }
        ContextMenuArea {
            Menu {
                Menu {
                    title: "Set State";
                    MenuItem {
                        title: "To Do";
                        activated => {
                            root.state_change_clicked(MindTaskState.Todo);
                        }
                    }

                    MenuItem {
                        title: "Doing";
                        activated => {
                            root.state_change_clicked(MindTaskState.Doing);
                        }
                    }

                    MenuItem {
                        title: "Done";
                        activated => {
                            root.state_change_clicked(MindTaskState.Done);
                        }
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: "Set Parent";
                    activated => {
                        root.set_parent_clicked();
                    }
                }

                MenuItem {
                    title: "Remove Parent";
                    activated => {
                        root.remove_parent_clicked();
                    }
                }

                MenuItem {
                    title: "Add Child";
                    activated => {
                        root.add_children_clicked();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: "New Child";
                    activated => {
                        root.new_children_clicked();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: "Duplicate";
                    activated => {
                        root.duplicate_clicked();
                    }
                }

                MenuItem {
                    title: "Delete";
                    activated => {
                        root.delete_clicked();
                    }
                }
            }

            VerticalLayout {
                Bubble {
                    text: task.title;
                    background: task.state == MindTaskState.Todo ? todo_color //
                      : task.state == MindTaskState.Doing ? doing_color //
                      : task.state == MindTaskState.Done ? done_color // 
                      : default_color;
                    border-color: root.active ? Styles.active_color : black;
                    drop-shadow-color: dragged ? #00000055 : #00000000;
                    drop-shadow-blur: dragged ? 20px : 0px;
                    drop-shadow-offset-x: 5px;
                    drop-shadow-offset-y: 5px;
                    animate drop-shadow-color, drop-shadow-blur, drop-shadow-offset-x, drop-shadow-offset-y {
                        duration: 180ms;
                        easing: ease-in-out;
                    }
                    if task.childrens.length > 0 && task.completion > 0:
                    HorizontalLayout {
                        alignment: center;
                        y: parent.y + parent.height - 5px;
                        MiddleProgressBar {
                            progress: task.completion;
                            height: 10px;
                            width: parent.width - 50px;
                        }
                    }
                }

                if extra_info:
                HorizontalLayout {
                    Text {
                        font-family: "Consolas";
                        text: Math.round(task.completion * 100) + "%";
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Text {
                        font-family: "Consolas";
                        text: task.id;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <[MindTask]> tasks;
    in property <TaskLoadingState> task_loading_state: TaskLoadingState.None;
    in property <string> task_loading_error_message;
    in property <TaskSavingState> task_saving_state: TaskSavingState.None;
    in property <string> task_saving_error_message;
    in property <float> overall_progress: 0.0;
    in property <int> active_task_index: -1;
    in property <int> history_past_count;
    in property <int> history_future_count;
    in property <int> history_limit;
    in property <string> last_command;
    in-out property <bool> debug_info: true;
    out property <AppMode> mode: AppMode.None;
    out property <int> hovered_task_index;
    in-out property <string> current_file_path: "";
    callback refresh_other();
    callback refresh_tasks();
    callback load(path: string);
    callback save(path: string);
    callback undo();
    callback redo();
    callback create_task(title: string, x: length, y: length);
    callback create_task_with_parent(parent_id: int, title: string, x: length, y: length);
    callback set_parent_to_task(id: int, parent: int);
    callback unset_parent_from_task(id: int);
    callback duplicate_task(id: int, x: length, y: length);
    callback delete_task(id: int);
    callback change_state(id: int, state: MindTaskState);
    callback task_moved_dropped(id: int, x: length, y: length);
    callback rename_task(id: int, title: string);
    callback set_task_description(id: int, description: string);
    callback set_active_task(id: int);
    callback clear_active_task();
    public function refresh_all() {
        root.refresh_tasks();
        root.refresh_other();
    }
    preferred-width: 600px;
    preferred-height: 600px;
    VerticalBox {
        HorizontalBox {
            padding: 0;
            alignment: stretch;
            Rectangle {
                workbench := WorkBench {
                    horizontal-stretch: 1;
                    debug_info: root.debug_info;
                    background: Styles.workbench_background_color;
                    background_detail_color: Styles.workbench_background_details_color;
                    workbench_clicked => {
                        root.clear_active_task();
                        root.mode = AppMode.None;
                    }
                    changed has-hover => {
                        if self.has-hover {
                            root.hovered_task_index = -1;
                        }
                    }
                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: "New Task";
                                activated => {
                                    create_task("New Task", workbench.mouse_pos_x, workbench.mouse_pos_y);
                                }
                            }
                        }
                    }

                    // place every edges
                    for task in tasks: //
                    Rectangle {
                        if task.parent_index != -1:
                        Edge {
                            stroke: Styles.edge_color;
                            stroke_width: 4px;
                            from_x: task.x;
                            from_y: task.y;
                            to_x: tasks[task.parent_index].x;
                            to_y: tasks[task.parent_index].y;
                        }
                    }

                    // preview edge for user feedback
                    // will snap to the hovered task if any
                    if root.mode == AppMode.SetParent //
                    || root.mode == AppMode.AddChildren:
                    Edge {
                        stroke: Styles.temporary_edge_color;
                        stroke_width: 4px;
                        from_x: tasks[active_task_index].x;
                        from_y: tasks[active_task_index].y;
                        to_x: root.hovered_task_index >= 0 //
                            ? root.tasks[root.hovered_task_index].x //
                            : workbench.mouse_pos_x;
                        to_y: root.hovered_task_index >= 0 //
                            ? root.tasks[root.hovered_task_index].y //
                            : workbench.mouse_pos_y;
                    }

                    // temp bubble
                    // bubble_b := TaskBubble {
                    //     x: workbench.center_x + self.task.x - self.width / 2;
                    //     y: workbench.center_y + self.task.y - self.height / 2;
                    //     active: false;
                    //     task: {
                    //         id: 55,
                    //         title: "Meow Meow Meow",
                    //         x: 123px,
                    //         y: 123px,
                    //         completion: 50%,
                    //         childrens: [1, 2, 3, 4],
                    //     };
                    //     moved_by(x, y) => {
                    //         self.task.x = x + self.task.x;
                    //         self.task.y = y + self.task.y;
                    //     }
                    // }

                    // place every tasks
                    for task[index] in tasks: TaskBubble {
                        x: workbench.center_x + task.x - self.width / 2;
                        y: workbench.center_y + task.y - self.height / 2;
                        task: task;
                        active: root.active_task_index >= 0 && root.tasks[active_task_index].id == task.id;
                        changed has-hover => {
                            if self.has-hover {
                                root.hovered_task_index = index;
                            }
                        }
                        moved_by(x, y) => {
                            task.x = x + task.x;
                            task.y = y + task.y;
                        }
                        released => {
                            root.task_moved_dropped(task.id, task.x, task.y);
                        }
                        delete_clicked() => {
                            root.delete_task(task.id);
                        }
                        state_change_clicked(state) => {
                            root.change_state(task.id, state)
                        }
                        set_parent_clicked => {
                            root.set_active_task(task.id);
                            root.mode = AppMode.SetParent;
                        }
                        remove_parent_clicked => {
                            root.unset_parent_from_task(task.id);
                        }
                        add_children_clicked => {
                            root.set_active_task(task.id);
                            root.mode = AppMode.AddChildren;
                        }
                        new_children_clicked => {
                            root.create_task_with_parent(task.id, "New Task", workbench.mouse_pos_x, workbench.mouse_pos_y);
                        }
                        duplicate_clicked => {
                            root.duplicate_task(task.id, workbench.mouse_pos_x, workbench.mouse_pos_y);
                        }
                        clicked => {
                            if root.mode == AppMode.SetParent {
                                root.set_parent_to_task(root.tasks[active_task_index].id, task.id);
                                root.mode = AppMode.None;
                                return;
                            }
                            if root.mode == AppMode.AddChildren {
                                root.set_parent_to_task(task.id, root.tasks[active_task_index].id);
                                root.mode = AppMode.None;
                                return;
                            }
                            root.set_active_task(task.id);
                        }
                    }
                }

                // debug overlay
                VerticalBox {
                    visible: root.debug_info;
                    alignment: start;
                    private property <string> font: "Consolas";
                    Text {
                        font-family: parent.font;
                        text: root.current_file_path == "" //
                            ? "Current File: None" //
                            : "Current File: " + root.current_file_path;
                    }

                    Text {
                        font-family: parent.font;
                        text: root.last_command == "" //
                            ? "Last command: None" //
                            : "Last command: " + root.last_command;
                    }

                    Text {
                        font-family: parent.font;
                        text: "History Past/Future: " + root.history_past_count + "/" + root.history_future_count + " (" + root.history_limit + ")";
                    }

                    Text {
                        font-family: parent.font;
                        text: "View Position: (" + Math.round(workbench.view_pos_x / 1px) + "," + Math.round(workbench.view_pos_y / 1px) + ")";
                    }

                    Text {
                        font-family: parent.font;
                        text: "Cursor position: (" + Math.round(workbench.mouse_pos_x / 1px) + ", " + Math.round(workbench.mouse_pos_y / 1px) + ")";
                    }

                    Text {
                        text: "Number of Tasks: " + root.tasks.length;
                    }

                    Text {
                        font-family: parent.font;
                        text: "Overall Progress: " + Math.round(root.overall_progress * 100) + "%";
                    }

                    Text {
                        text: root.active_task_index >= 0 //
                            ? "Active Task: #" + root.tasks[active_task_index].id //
                            : "Active Task: None";
                    }

                    Text {
                        text: root.hovered_task_index >= 0 //
                            ? "Hovered Task: #" + root.tasks[hovered_task_index].id //
                            : "Hovered Task: None";
                    }

                    Text {
                        font-family: parent.font;
                        text: root.mode == AppMode.None ? "Application Mode: None" //
                            : root.mode == AppMode.AddChildren ? "Application Mode: AddChildren" //
                            : root.mode == AppMode.SetParent ? "Application Mode: SetParent" //
                            : "Mode: AAAAAAAAAAAAA";
                    }
                }
            }

            if root.active_task_index >= 0:
            TaskDetailPanel {
                task: root.tasks[active_task_index];
                show: root.active_task_index != -1;
                width: 400px;
                delete_clicked => {
                    root.delete_task(root.tasks[active_task_index].id);
                }
                title_changed(title) => {
                    root.tasks[active_task_index].title = title;
                }
                title_submitted(title) => {
                    root.rename_task(root.tasks[active_task_index].id, title);
                }
                description_submitted(description) => {
                    root.set_task_description(root.tasks[active_task_index].id, description);
                }
                state_changed(state) => {
                    root.change_state(root.tasks[active_task_index].id, state);
                }
            }
        }

        // button controls
        HorizontalBox {
            padding: 0px;
            Button {
                text: "Center View";
                clicked => {
                    workbench.move_view_to(workbench.center_x, workbench.center_y);
                }
            }

            Button {
                text: "Clear Active";
                clicked => {
                    root.clear_active_task();
                }
            }

            Button {
                text: "Reset Mode";
                clicked => {
                    root.mode = AppMode.None;
                }
            }

            Button {
                text: "Refresh All";
                clicked => {
                    root.refresh_all();
                }
            }

            Button {
                text: "Undo";
                enabled: root.history_past_count > 0;
                clicked => {
                    root.undo();
                }
            }

            Button {
                text: "Redo";
                enabled: root.history_future_count > 0;
                clicked => {
                    root.redo();
                }
            }

            ThemeSwitch { }

            Rectangle {
                horizontal-stretch: 1;
            }

            CheckBox {
                text: "Debug Info";
                checked <=> root.debug_info;
            }

            FileDialogButton {
                text: "Load";
                title: "Load file";
                filters: [{ text: "FireWork", extensions : ["fwork"] }];
                type: FileDialogType.load;
                picked(path) => {
                    root.current_file_path = path;
                    root.load(path);
                }
            }

            FileDialogButton {
                text: "Save";
                title: "Save file";
                filters: [{ text: "FireWork", extensions : ["fwork"] }];
                default_file: root.current_file_path;
                type: FileDialogType.save;
                picked(path) => {
                    root.current_file_path = path;
                    root.save(path);
                }
            }
        }
    }
}
