                //     stroke: #ff0000aa;
                //     stroke-width: 3px;
                //     private property <length> from_x: bubble_a.x + bubble_a.width / 2;
                //     private property <length> from_y: bubble_a.y + bubble_a.height / 2;
                //     private property <length> to_x: bubble_b.x + bubble_b.width / 2;
                //     private property <length> to_y: bubble_b.y + bubble_b.height / 2;
                //     MoveTo {
                //         x: from_x / 1px;
