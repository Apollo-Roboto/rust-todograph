                //     }
                // }

                // // temp bubble
                // bubble_a := Bubble {
                //     x: pan_box.center_x;
                //     y: pan_box.center_y;
                //     text: "Do Thing";
                // }


                // // temp edges
                // for edge in [ //
                //     [-100px, 0px, 100px, 100px],
                //     [50px, 25px, 100px, 25px],
                //     [100px, 100px, 200px, 200px],
                //     [100px, 100px, 200px, 100px],
                //     // //
                //     [0px, 0px, -30px, 0px],
                //     [0px, 0px, -30px, 30px],
                //     [0px, 0px, -30px, -30px],
