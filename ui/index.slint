import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

enum MindTaskState {
    Todo,
    Doing,
    Done,
}

struct MindTask {
    title: string,
    state: MindTaskState,
    x: length,
    y: length,
}

component Bubble inherits Rectangle {
    in property <string> text <=> _text.text;
    in property <length> horizontal_padding: 35px;
    in property <length> vertical_padding: 20px;
    height: _text.height + vertical_padding;
    width: _text.width + horizontal_padding;
    border-width: 1px;
    border-color: black;
    border-radius: 16px;
    background: #333333;
    _text := Text { }
}

